# Copy to .env (never commit .env) and export before running:  set -a; source .env; set +a
# Demo mode: no key, scripted stand-in (NOT a model). Good for clicking through the UI.
APPBUILDER_PROVIDER=gemini
APPBUILDER_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Live, Gemini (learner-owned key; free tier first). The model id is YOUR choice: ids change, so there is no default.
# APPBUILDER_PROVIDER=gemini
# APPBUILDER_MODEL=<a Gemini model id your key can use, e.g. from https://ai.google.dev/gemini-api/docs/models>
# GEMINI_API_KEY=

# Live, local fallback (Ollama must be running and the model pulled; the model must support tool calling)
# APPBUILDER_PROVIDER=ollama
# APPBUILDER_MODEL=<model you pulled>

APPBUILDER_IMPL=handwritten          # or: framework (LangGraph)
APPBUILDER_DATA_DIR=./data
APPBUILDER_API_PORT=8080
APPBUILDER_PREVIEW_PORT=8081
# APPBUILDER_STRUCTURED_MODE=prompt_only   # or json_object / json_schema after you verify your provider honours them
# Optional prices (USD per million tokens) so cost is computed; without them cost is reported as "unpriced"
# APPBUILDER_PRICE_INPUT_PER_M=
# APPBUILDER_PRICE_OUTPUT_PER_M=
